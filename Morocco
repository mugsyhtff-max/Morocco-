function renderPack(k){
  pl.classList.remove('swap');void pl.offsetWidth;pl.classList.add('swap');
  pl.innerHTML=PACK[k].map(function(it){return '<li tabindex="0" role="checkbox" aria-checked="false"><span class="cb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 12l5 5L20 7"/></svg></span>'+it+'</li>'}).join('');
  $$('li',pl).forEach(function(li){
    function tog(){li.classList.toggle('done');li.setAttribute('aria-checked',li.classList.contains('done'))}
    li.addEventListener('click',tog);
    li.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();tog()}});
  });
}
renderPack(pk[0]);

