/* ---------- MODAL ---------- */
var modal=$('#modal'),curId=null;
function findItem(id){return EXP.filter(function(x){return x.id===id})[0]||TOURS.filter(function(x){return x.id===id})[0]}
function openModal(id){
  var x=findItem(id);if(!x)return;curId=id;lastFocus=document.activeElement;
  $('#mImg').src=x.img;$('#mImg').alt=x.title+' — full details';
  $('#mKind').textContent=x.kind;$('#mTitle').textContent=x.title;$('#mLong').textContent=x.long;$('#mPrice').textContent=x.price;
  $('#mMeta').innerHTML='<span>'+x.dur+'</span><span>'+x.diff+'</span><span>'+x.season+'</span>';
  $('#mHi').innerHTML=x.hi.map(function(h){return '<li>'+h+'</li>'}).join('');
  $('#mInc').innerHTML=x.inc.map(function(h){return '<li>'+h+'</li>'}).join('');
  var iw=$('#mItinWrap');
  if(x.itin){iw.style.display='';$('#mItin').innerHTML=x.itin.map(function(r){return '<li><b>'+r[0]+'</b><span>'+r[1]+'</span></li>'}).join('')}else{iw.style.display='none'}
  modal.hidden=false;document.body.classList.add('locked');
  requestAnimationFrame(function(){requestAnimationFrame(function(){modal.classList.add('open')})});
  $('.mx',modal).focus();
}
function closeModal(){
  modal.classList.remove('open');document.body.classList.remove('locked');
  setTimeout(function(){modal.hidden=true},RM?0:450);
  if(lastFocus)lastFocus.focus();
}
document.addEventListener('click',function(e){
  var b=e.target.closest('[data-exp],[data-tour]');
  if(b){openModal(b.getAttribute('data-exp')||b.getAttribute('data-tour'));return}
  if(e.target.closest('[data-close]')&&!modal.hidden){closeModal()}
});
$('#mBook').addEventListener('click',function(){
  var id=curId;closeModal();
  var sel=$('#inExp');if(id){sel.value=id}
  setTimeout(function(){$('#book').scrollIntoView({behavior:RM?'auto':'smooth'});$('#bform').style.boxShadow='0 0 0 3px rgba(216,169,91,.5)';setTimeout(function(){$('#bform').style.boxShadow=''},1400)},RM?0:300);
});
/* focus trap */
modal.addEventListener('keydown',function(e){
  if(e.key!=='Tab')return;
  var f=$$('button,a[href],select,input,textarea',[modal]).filter(function(el){return el.offsetParent!==null});
  if(!f.length)return;
  var first=f[0],last=f[f.length-1];
  if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
  else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}
});

/* ---------- LIGHTBOX ---------- */
var lb=$('#lightbox'),lbI=0;
function openLB(i){lbI=i;renderLB();lb.hidden=false;document.body.classList.add('locked');$('#lbClose').focus()}
function renderLB(){var g=GAL[lbI];var im=$('#lbImg');im.src=g[0];im.alt=g[1];$('#lbCap').textContent=g[1];$('#lbCount').textContent=(lbI+1)+' / '+GAL.length;
  if(!RM){im.style.animation='none';void im.offsetWidth;im.style.animation=''}}
function closeLB(){lb.hidden=true;document.body.classList.remove('locked')}
$('#lbPrev').addEventListener('click',function(){lbI=(lbI-1+GAL.length)%GAL.length;renderLB()});
$('#lbNext').addEventListener('click',function(){lbI=(lbI+1)%GAL.length;renderLB()});
$('#lbClose').addEventListener('click',closeLB);
lb.addEventListener('click',function(e){if(e.target===lb)closeLB()});

/* ---------- ESC ---------- */
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){
    if(!lb.hidden)closeLB();
    else if(!modal.hidden)closeModal();
    else if(document.body.classList.contains('menu-open'))setMenu(false);
  }
  if(!lb.hidden){
    if(e.key==='ArrowLeft')$('#lbPrev').click();
    if(e.key==='ArrowRight')$('#lbNext').click();
  }
});

