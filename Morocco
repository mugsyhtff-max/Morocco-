#oasis .eyebrow{color:#8fd0a4}#oasis .eyebrow::before{background:#8fd0a4}
#oasis p.body{color:#b9c6b4;margin-top:18px}
#oasis .round{border-radius:50% 50% 46% 54%/58% 44% 56% 42%;overflow:hidden;box-shadow:0 40px 90px rgba(0,0,0,.5);border:1px solid rgba(143,208,164,.25)}
#oasis .round img{transition:transform 1.6s var(--ease)}
#oasis .round:hover img{transform:scale(1.07) rotate(1deg)}
/* Nomad */
#nomad{background:var(--emberbg)}
#nomad::before{content:"";position:absolute;inset:0;background:radial-gradient(60% 50% at 20% 80%,rgba(201,112,59,.16),transparent 70%)}
#nomad .ngrid{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(36px,5vw,80px);align-items:center}
#nomad .nimg{border-radius:20px;overflow:hidden;box-shadow:0 40px 90px rgba(0,0,0,.55)}
#nomad .nimg img{transition:transform 1.4s var(--ease)}
#nomad .nimg:hover img{transform:scale(1.05)}
#nomad p.body{color:var(--muted);margin-top:18px}
#nomad .nquote{font:italic 500 clamp(1.2rem,2.2vw,1.6rem)/1.55 var(--serif);color:var(--sand);border-left:2px solid var(--ember);padding-left:24px;margin-top:26px}
/* dune divider */
.dunes{line-height:0;position:relative;z-index:5}
.dunes svg{width:100%;height:110px;display:block}
.dunes .db{opacity:.35}
/* ============ CAMP ============ */
#camp .cgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;margin-top:56px}
#camp .cmain{border-radius:22px;overflow:hidden;position:relative;min-height:520px;box-shadow:0 40px 90px rgba(60,40,10,.3)}
#camp .cmain img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.6s var(--ease)}
#camp .cmain:hover img{transform:scale(1.05)}
#camp .cglass{position:absolute;left:22px;right:22px;bottom:22px;background:rgba(14,10,7,.6);backdrop-filter:blur(16px);border:1px solid var(--line);border-radius:16px;padding:20px 24px;display:flex;gap:26px;flex-wrap:wrap}
#camp .cglass div b{font:400 1.3rem var(--disp);color:var(--gold);display:block}
#camp .cglass div span{font:500 10px var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--muted)}
#camp .cside{display:grid;gap:18px}
#camp .cside .cimg{border-radius:22px;overflow:hidden;position:relative;flex:1;min-height:250px;box-shadow:0 30px 70px rgba(60,40,10,.28)}
#camp .cside .cimg img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}
#camp .cside .cimg:hover img{transform:scale(1.06)}
#camp .amen{display:grid;grid-template-columns:1fr 1fr;gap:12px 26px;margin-top:44px}
#camp .amen li{display:flex;gap:12px;align-items:flex-start;color:var(--ink-m);font-size:.95rem;padding:12px 0;border-bottom:1px solid var(--line-d)}
#camp .amen svg{width:18px;height:18px;stroke:var(--gold2);flex:none;margin-top:3px}
/* ============ EXPERIENCES ============ */
#experiences .egrid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:60px}
.xcard{background:linear-gradient(160deg,#1a130b,#120d07);border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .5s var(--ease),box-shadow .5s,border-color .5s}
.xcard:hover{transform:translateY(-10px);border-color:rgba(216,169,91,.5);box-shadow:0 30px 70px rgba(0,0,0,.55)}
.xcard .ximg{height:230px;overflow:hidden;position:relative}
.xcard .ximg img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s var(--ease)}
.xcard:hover .ximg img{transform:scale(1.09)}
.xcard .xcat{position:absolute;top:14px;left:14px;background:rgba(14,10,7,.65);backdrop-filter:blur(10px);border:1px solid var(--line);color:var(--gold);font:600 9.5px var(--sans);letter-spacing:.26em;text-transform:uppercase;border-radius:999px;padding:7px 14px}
.xcard .xbody{padding:24px 24px 26px;display:flex;flex-direction:column;gap:12px;flex:1}
.xcard h3{font:400 1.5rem var(--disp);letter-spacing:.04em;color:var(--cream)}
.xcard .xshort{color:var(--muted);font-size:.93rem;flex:1}
.xmeta{display:flex;gap:16px;flex-wrap:wrap;font:500 10.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--sand)}
.xmeta span{display:flex;gap:7px;align-items:center}
.xmeta svg{width:14px;height:14px;stroke:var(--gold)}
.btn-disc{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;font:600 11px var(--sans);letter-spacing:.26em;text-transform:uppercase;color:var(--gold);padding:6px 0;position:relative}
.btn-disc::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;background:var(--gold);transform:scaleX(.35);transform-origin:left;transition:transform .45s var(--ease)}
.btn-disc:hover::after{transform:scaleX(1)}
.btn-disc svg{width:15px;height:15px;transition:transform .3s}
.btn-disc:hover svg{transform:translateX(5px)}
/* ============ TOURS ============ */
#tours{background:var(--bg2)}
.tscroll{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding:56px 4px 26px;scrollbar-width:none}
.tscroll::-webkit-scrollbar{display:none}
.tcard{flex:0 0 min(400px,84vw);scroll-snap-align:start;background:linear-gradient(170deg,#20180e,#140e07);border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .5s var(--ease),border-color .4s}
.tcard:hover{transform:translateY(-8px);border-color:rgba(216,169,91,.5)}
.tcard .timg{height:210px;overflow:hidden;position:relative}
.tcard .timg img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s var(--ease)}
.tcard:hover .timg img{transform:scale(1.08)}
.tcard .tkind{position:absolute;top:14px;left:14px;background:linear-gradient(120deg,var(--gold2),var(--gold));color:#241505;font:600 9.5px var(--sans);letter-spacing:.24em;text-transform:uppercase;border-radius:999px;padding:7px 14px}
.tcard .tbody{padding:24px;display:flex;flex-direction:column;gap:12px;flex:1}
.tcard h3{font:400 1.55rem var(--disp);color:var(--cream)}
.tcard .tmeta{display:flex;gap:16px;font:500 10.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--sand)}
.tcard .troute{border-left:1px solid var(--line);padding-left:16px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:.9rem;flex:1}
.tcard .troute li::before{content:"◆";color:var(--gold);font-size:8px;margin-right:9px;vertical-align:2px}
.tcard .tfoot{display:flex;justify-content:space-between;align-items:center;margin-top:6px}
.tcard .price{font:400 1.25rem var(--disp);color:var(--gold)}
.tnav{display:flex;gap:12px;justify-content:flex-end;margin-top:8px}
.tnav button{width:52px;height:52px;border-radius:50%;border:1px solid var(--line);color:var(--gold);display:grid;place-items:center;transition:.3s}
.tnav button:hover{background:var(--gold);color:#241505;border-color:var(--gold)}
/* ============ GALLERY ============ */
.gal{columns:3;gap:18px;margin-top:56px}
.gal figure{break-inside:avoid;margin-bottom:18px;border-radius:16px;overflow:hidden;position:relative;cursor:zoom-in;border:1px solid rgba(255,255,255,.06)}
.gal img{width:100%;transition:transform 1.2s var(--ease),filter .6s}
.gal figure:hover img{transform:scale(1.06)}
.gal figcaption{position:absolute;inset:auto 0 0 0;padding:40px 18px 14px;background:linear-gradient(transparent,rgba(10,7,4,.85));font:italic 500 .95rem var(--serif);color:var(--sand);opacity:0;transform:translateY(10px);transition:.5s var(--ease)}
.gal figure:hover figcaption{opacity:1;transform:none}
/* ============ ROUTE MAP ============ */
#route{background:var(--night)}
#route .rgrid{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(30px,4vw,60px);margin-top:50px;align-items:start}
#rmap{width:100%;height:auto;border:1px solid rgba(216,169,91,.18);border-radius:20px;background:radial-gradient(90% 90% at 60% 30%,#101527,#0a0d15 70%)}
#rmap .road{stroke:rgba(216,169,91,.85);stroke-width:2.4;fill:none;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 3s var(--ease) .3s}
#rmap .offroad{stroke:rgba(216,169,91,.5);stroke-width:2;stroke-dasharray:.012 .012;fill:none}
#route.in .road{stroke-dashoffset:0}
#rmap .contour{stroke:rgba(120,140,190,.14);fill:none;stroke-width:1}
#rmap .wp{cursor:pointer}
#rmap .wp circle.ring{fill:#0a0d15;stroke:var(--gold);stroke-width:1.4;transition:.3s}
#rmap .wp circle.core{fill:var(--gold);transition:.3s}
#rmap .wp text{fill:#8b93a8;font:500 12px var(--sans);letter-spacing:.08em;transition:.3s}
#rmap .wp:hover circle.ring,#rmap .wp.on circle.ring{stroke-width:2.4;filter:drop-shadow(0 0 6px rgba(216,169,91,.8))}
#rmap .wp.on circle.core{fill:#fff}
#rmap .wp.on text{fill:var(--cream)}
#rmap .base circle.ring{stroke:#8fd0a4}
#rmap .base circle.core{fill:#8fd0a4}
#rmap .base text{fill:#8fd0a4}
#rmap .pulse{fill:none;stroke:#8fd0a4;animation:wp-pulse 2.4s ease-out infinite;transform-origin:center;transform-box:fill-box}
@keyframes wp-pulse{from{opacity:.9;transform:scale(1)}to{opacity:0;transform:scale(2.6)}}
.rpanel{background:rgba(13,17,30,.6);backdrop-filter:blur(14px);border:1px solid rgba(216,169,91,.2);border-radius:20px;padding:30px;position:sticky;top:calc(var(--nav-h) + 26px)}
.rpanel h3{font:400 1.8rem var(--disp);color:var(--cream)}
.rpanel .rtag{font:600 10px var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}
.rpanel p{color:#9aa2b5;font-size:.94rem;margin-top:12px}
.rpanel .rstats{display:flex;gap:22px;margin-top:20px;border-top:1px solid rgba(216,169,91,.16);padding-top:18px}
.rpanel .rstats b{font:400 1.3rem var(--disp);color:var(--gold);display:block}
.rpanel .rstats span{font:500 10px var(--sans);letter-spacing:.22em;text-transform:uppercase;color:#77809a}
/* ============ TIMELINE ============ */
#day{background:var(--bg2)}
.tl{position:relative;margin-top:64px;padding-left:34px}
.tl::before{content:"";position:absolute;left:8px;top:0;bottom:0;width:1px;background:var(--line)}
.tl .fill{position:absolute;left:8px;top:0;width:1px;height:0;background:linear-gradient(var(--gold),var(--ember));transition:height 2.4s var(--ease)}
#day.in .fill{height:100%}
.tl li{position:relative;padding:0 0 42px 26px}
.tl li::before{content:"";position:absolute;left:-30px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--bg2);border:2px solid var(--gold);box-shadow:0 0 0 4px rgba(216,169,91,.12)}
.tl time{font:400 1.15rem var(--disp);color:var(--gold);letter-spacing:.14em}
.tl h3{font:400 1.4rem var(--disp);color:var(--cream);margin:4px 0 6px;letter-spacing:.05em}
.tl p{color:var(--muted);max-width:60ch;font-size:.95rem}
/* ============ STATS ============ */
#stats{background:linear-gradient(120deg,#1d1409,#2a1c0c 55%,#1d1409);border-block:1px solid var(--line)}
#stats .sgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;text-align:center}
#stats b{font:400 clamp(2.4rem,4.6vw,4rem)/1 var(--disp);color:var(--gold);display:block}
#stats b sup{font-size:.45em;color:var(--ember)}
#stats span{font:500 10.5px var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--muted);display:block;margin-top:10px}
/* ============ BEST TIME ============ */
#best-time .months{display:flex;flex-wrap:wrap;gap:10px;margin-top:46px}
#best-time .mo{border:1px solid var(--line-d);border-radius:999px;padding:12px 20px;font:600 12px var(--sans);letter-spacing:.16em;color:var(--ink-m);transition:.3s;position:relative}
#best-time .mo.best::after{content:"";position:absolute;top:-3px;right:-2px;width:8px;height:8px;border-radius:50%;background:var(--gold2)}
#best-time .mo:hover{border-color:var(--gold2);color:var(--ink)}
#best-time .mo.on{background:var(--ink);color:var(--cream);border-color:var(--ink)}
#best-time .bpanel{margin-top:36px;background:#fff8ea;border:1px solid var(--line-d);border-radius:22px;padding:clamp(26px,4vw,46px);display:grid;grid-template-columns:auto 1fr;gap:clamp(24px,4vw,60px);align-items:center;box-shadow:0 30px 70px rgba(60,40,10,.12)}
#best-time .btemp{font:400 clamp(3rem,6vw,5rem)/1 var(--disp);color:var(--gold2)}
#best-time .btemp small{font:italic 500 1rem var(--serif);color:var(--ink-m);display:block;margin-top:8px}
#best-time .bpanel h3{font:400 1.7rem var(--disp)}
#best-time .bpanel p{color:var(--ink-m);margin-top:10px;max-width:60ch}
#best-time .bideal{margin-top:14px;font:600 11px var(--sans);letter-spacing:.22em;text-transform:uppercase;color:var(--gold2)}
#best-time .bpanel.fade{animation:bfade .5s var(--ease)}
@keyframes bfade{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
/* ============ PACKING ============ */
#packing .ptabs{display:flex;gap:10px;flex-wrap:wrap;margin-top:46px}
#packing .ptab{border:1px solid var(--line);border-radius:999px;padding:12px 24px;font:600 11px var(--sans);letter-spacing:.22em;text-transform:uppercase;color:var(--muted);transition:.3s}
#packing .ptab.on{background:var(--gold);color:#241505;border-color:var(--gold)}
#packing .plist{margin-top:34px;display:grid;grid-template-columns:1fr 1fr;gap:12px 40px}
#packing .plist li{display:flex;gap:14px;align-items:center;padding:14px 6px;border-bottom:1px solid var(--line);color:var(--muted);cursor:pointer;transition:.3s}
#packing .plist li .cb{width:20px;height:20px;border-radius:6px;border:1px solid var(--line);display:grid;place-items:center;flex:none;transition:.3s}
#packing .plist li .cb svg{width:12px;height:12px;stroke:#241505;stroke-width:3;opacity:0;transition:.2s}
#packing .plist li.done{color:var(--cream)}
#packing .plist li.done .cb{background:var(--gold);border-color:var(--gold)}
#packing .plist li.done .cb svg{opacity:1}
#packing .plist.swap{animation:bfade .5s var(--ease)}
/* ============ TIPS ============ */
#tips .tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.tipcard{background:#fbf4e4;border:1px solid var(--line-d);border-radius:18px;padding:30px;transition:transform .45s var(--ease),box-shadow .45s}
.tipcard:hover{transform:translateY(-8px);box-shadow:0 26px 60px rgba(60,40,10,.16)}
.tipcard .ic{width:46px;height:46px;border-radius:14px;background:var(--ink);display:grid;place-items:center;margin-bottom:18px}
.tipcard .ic svg{width:20px;height:20px;stroke:var(--gold)}
.tipcard h3{font:400 1.3rem var(--disp);margin-bottom:8px}
.tipcard p{color:var(--ink-m);font-size:.93rem}
/* ============ FAQ ============ */
#faq .flist{margin-top:50px;border-top:1px solid var(--line)}
.fitem{border-bottom:1px solid var(--line)}
.fitem button{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px 6px;text-align:left;color:var(--cream);font:400 1.25rem var(--disp);letter-spacing:.04em;transition:color .3s}
.fitem button:hover{color:var(--gold)}
.fitem .fi{width:34px;height:34px;flex:none;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;transition:.4s var(--ease)}
.fitem .fi svg{width:14px;height:14px;stroke:var(--gold);transition:.4s var(--ease)}
.fitem.open .fi{background:var(--gold);border-color:var(--gold)}
.fitem.open .fi svg{transform:rotate(45deg);stroke:#241505}
.fitem .fa{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s var(--ease)}
.fitem.open .fa{grid-template-rows:1fr}
.fitem .fa>div{overflow:hidden}
.fitem .fa p{color:var(--muted);padding:0 6px 28px;max-width:75ch}
/* ============ TESTIMONIALS ============ */
#testimonials{background:var(--cream);color:var(--ink);overflow:hidden}
#testimonials .qmark{position:absolute;top:30px;left:4vw;font:400 22rem/1 var(--disp);color:rgba(185,132,54,.12);pointer-events:none}
.tslider{margin-top:40px;overflow:hidden}
.ttrack{display:flex;transition:transform .8s var(--ease)}
.tslide{flex:0 0 100%;padding:10px 4px}
.tslide blockquote{font:italic 500 clamp(1.3rem,2.6vw,1.9rem)/1.55 var(--serif);color:var(--ink);max-width:900px}
.tslide .who{display:flex;align-items:center;gap:16px;margin-top:30px}
.tslide .av{width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--ember));color:#fff;display:grid;place-items:center;font:600 15px var(--sans);letter-spacing:.06em}
.tslide .who b{font:600 13px var(--sans);letter-spacing:.14em;text-transform:uppercase}
.tslide .who span{display:block;color:var(--ink-m);font:italic 500 .95rem var(--serif)}
.tctrl{display:flex;align-items:center;gap:20px;margin-top:40px}
.tctrl button.arr{width:52px;height:52px;border-radius:50%;border:1px solid var(--line-d);display:grid;place-items:center;color:var(--ink);transition:.3s}
.tctrl button.arr:hover{background:var(--ink);color:var(--gold);border-color:var(--ink)}
.tdots{display:flex;gap:8px}
.tdots button{width:26px;height:3px;border-radius:3px;background:var(--line-d);transition:.3s}
.tdots button.on{background:var(--gold2);width:44px}
/* ============ BOOKING ============ */
#book .bgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:26px;margin-top:56px}
#bform{background:rgba(22,15,8,.6);backdrop-filter:blur(18px);border:1px solid var(--line);border-radius:24px;padding:clamp(28px,4vw,48px);position:relative;overflow:hidden}
#bform .frow{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.field{margin-bottom:18px}
.field label{display:block;font:600 10.5px var(--sans);letter-spacing:.26em;text-transform:uppercase;color:var(--sand);margin-bottom:9px}
.field input,.field select,.field textarea{width:100%;background:rgba(10,7,4,.5);border:1px solid var(--line);border-radius:12px;padding:15px 18px;color:var(--cream);font:300 15px var(--sans);transition:border-color .3s,box-shadow .3s;color-scheme:dark}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(216,169,91,.15)}
.field.err input,.field.err select{border-color:#d05a3a;box-shadow:0 0 0 3px rgba(208,90,58,.15)}
.field .fmsg{display:none;color:#e08a70;font-size:12px;margin-top:7px}
.field.err .fmsg{display:block}
#bsubmit{width:100%;justify-content:center}
#bsubmit .spin{display:none;width:16px;height:16px;border:2px solid rgba(36,21,5,.3);border-top-color:#241505;border-radius:50%;animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
#bsubmit.loading .spin{display:block}
#bsubmit.loading .lbl{opacity:.6}
#bsuccess{display:none;text-align:center;padding:40px 10px}
#bsuccess.show{display:block;animation:bfade .6s var(--ease)}
#bsuccess .ck{width:96px;height:96px;margin:0 auto 26px}
#bsuccess .ck circle{stroke:var(--gold);stroke-width:1.6;fill:none;stroke-dasharray:302;stroke-dashoffset:302;animation:draw 1s var(--ease) forwards}
#bsuccess .ck path{stroke:var(--gold);stroke-width:3;fill:none;stroke-linecap:round;stroke-dasharray:80;stroke-dashoffset:80;animation:draw .7s var(--ease) .7s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
#bsuccess h3{font:400 2rem var(--disp);color:var(--cream)}
#bsuccess p{color:var(--muted);margin:12px auto 28px;max-width:46ch}
#bsuccess .sbtns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.bside{display:flex;flex-direction:column;gap:18px}
.bcard{background:rgba(22,15,8,.6);backdrop-filter:blur(18px);border:1px solid var(--line);border-radius:20px;padding:28px}
.bcard h4{font:400 1.3rem var(--disp);color:var(--cream);margin-bottom:14px}
.bcard .crow{display:flex;gap:14px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(216,169,91,.12);color:var(--muted);font-size:.94rem}
.bcard .crow:last-child{border:none}
.bcard .crow svg{width:18px;height:18px;stroke:var(--gold);flex:none}
.bcard .crow a:hover{color:var(--gold)}
.bcard .promise{font:italic 500 1.02rem/1.6 var(--serif);color:var(--sand)}
/* ============ FOOTER ============ */
footer{background:#080502;border-top:1px solid var(--line);position:relative;overflow:hidden}
.fword{font:400 clamp(4rem,14vw,13rem)/1 var(--disp);letter-spacing:.1em;text-align:center;color:transparent;-webkit-text-stroke:1px rgba(216,169,91,.16);padding:70px 0 10px;user-select:none}
.fgrid{display:grid;grid-template-columns:1.3fr .7fr .7fr 1fr;gap:40px;padding:50px 0 60px}
.fgrid h5{font:600 11px var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
.fgrid a{display:block;color:var(--muted);padding:5px 0;font-size:.93rem;transition:.3s}
.fgrid a:hover{color:var(--gold);padding-left:6px}
.fgrid p{color:var(--muted);font-size:.93rem;max-width:36ch}
#nlform{display:flex;gap:10px;margin-top:18px}
