    $('#mailLink').href='mailto:hello@foumzguidtrip.com?subject='+encodeURIComponent('Reservation request — '+name)+'&body='+encodeURIComponent(wa+'\n\nEmail: '+email+($('#inWa').value?'\nWhatsApp: '+$('#inWa').value:''));
    toast('Request prepared — see you in the dunes');
  },1400);
});
$('#bAgain').addEventListener('click',function(){$('#bsuccess').classList.remove('show');$('#bfields').style.display=''});

