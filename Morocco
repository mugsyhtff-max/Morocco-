<!-- ============ ERG CHEGAGA ============ -->
<section id="erg-chegaga" class="panel">
  <div class="pimg"><img src="https://image.qwenlm.ai/public_source/59e3c0a3-0889-46ea-884f-ad206b7115d9/141d962cc-7140-4c0e-aba2-c3f2805949bc.png" alt="Wind-carved ridgeline of the Erg Chegaga dunes dividing light and shadow" loading="lazy" data-px="0.12"></div>
