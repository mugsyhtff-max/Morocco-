/* ---------- PACKING ---------- */
var pt=$('#packTabs'),pl=$('#packList'),pk=Object.keys(PACK);
pk.forEach(function(k,i){
  var b=document.createElement('button');b.className='ptab'+(i===0?' on':'');b.textContent=k;b.setAttribute('role','tab');
  b.addEventListener('click',function(){
    $$('.ptab',pt).forEach(function(x){x.classList.remove('on')});b.classList.add('on');renderPack(k);
  });
  pt.appendChild(b);
