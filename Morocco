  for(var i=0;i<txt.length;i++){var s=document.createElement('span');s.className='ch';s.style.setProperty('--i',i);s.textContent=txt[i];el.appendChild(s)}
});
/* ---------- SCRAMBLE ---------- */
function scrambleAll(){
  $$('[data-scramble]').forEach(function(el){
    var target=el.getAttribute('data-text');if(RM){el.textContent=target;return}
    var chars='◆·—/\\0123456789NW°′';var frame=0;
    var iv=setInterval(function(){
      frame++;var out='';var done=Math.floor(frame/2);
      for(var i=0;i<target.length;i++){out+= i<done?target[i]:(target[i]===' '?' ':chars[Math.floor(Math.random()*chars.length)])}
      el.textContent=out;if(done>=target.length){clearInterval(iv);el.textContent=target}
    },30);
  });
}

/* ---------- REVEAL ---------- */
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
$$('[data-rv]').forEach(function(el){io.observe(el)});
var secIO=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');secIO.unobserve(e.target)}})},{threshold:.25});
['#route','#day'].forEach(function(s){var el=$(s);if(el)secIO.observe(el)});

/* ---------- COUNTERS ---------- */
var cio=new IntersectionObserver(function(es){es.forEach(function(e){
  if(!e.isIntersecting)return;cio.unobserve(e.target);
  var el=e.target,end=parseFloat(el.getAttribute('data-count')),dec=parseInt(el.getAttribute('data-dec')||'0',10);
  if(RM){el.textContent=end.toLocaleString('en-US',{minimumFractionDigits:dec});return}
  var t0=null;function step(ts){if(!t0)t0=ts;var p=Math.min((ts-t0)/1800,1);p=1-Math.pow(1-p,4);el.textContent=(end*p).toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec});if(p<1)requestAnimationFrame(step)}
  requestAnimationFrame(step);
})},{threshold:.6});
$$('[data-count]').forEach(function(el){cio.observe(el)});

/* ---------- SAND PARTICLES ---------- */
(function(){
  if(RM)return;var c=$('#sand'),ctx=c.getContext('2d'),W,H,ps=[],t=0;
  function rs(){W=c.width=innerWidth;H=c.height=innerHeight}
  rs();addEventListener('resize',rs);
  var N=innerWidth<720?34:70;
  for(var i=0;i<N;i++)ps.push({x:Math.random()*W,y:Math.random()*H,r:.5+Math.random()*1.5,s:.25+Math.random()*.85,o:.06+Math.random()*.26,ph:Math.random()*6.28});
  function loop(){
    if(document.hidden){requestAnimationFrame(loop);return}
    ctx.clearRect(0,0,W,H);t+=.006;
    for(var i=0;i<ps.length;i++){var p=ps[i];
      p.x+=p.s*1.1;p.y+=Math.sin(t*2+p.ph)*.35;
      if(p.x>W+4){p.x=-4;p.y=Math.random()*H}
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,6.283);ctx.fillStyle='rgba(224,183,120,'+p.o+')';ctx.fill();
    }
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();

/* ---------- CURSOR GLOW ---------- */
(function(){
  if(RM||!matchMedia('(pointer:fine)').matches)return;
  var g=$('#glow'),x=innerWidth/2,y=innerHeight/2,cx=x,cy=y;
  addEventListener('mousemove',function(e){x=e.clientX;y=e.clientY});
  (function loop(){cx+=(x-cx)*.08;cy+=(y-cy)*.08;g.style.left=cx+'px';g.style.top=cy+'px';requestAnimationFrame(loop)})();
})();

/* ---------- NAV / SCROLL ---------- */
var nav=$('#nav'),prog=$('#progress'),totop=$('#totop');
var pxEls=$$('[data-px]');
var ticking=false;
function onScroll(){
  var sy=scrollY;
  nav.classList.toggle('scrolled',sy>40);
  totop.classList.toggle('show',sy>700);
  var h=document.documentElement.scrollHeight-innerHeight;
  prog.style.width=(h>0?(sy/h)*100:0)+'%';
  if(!RM){pxEls.forEach(function(el){
    var r=el.parentElement.getBoundingClientRect();
    var off=(r.top+r.height/2-innerHeight/2)*parseFloat(el.getAttribute('data-px'));
    el.style.transform='translate3d(0,'+off.toFixed(1)+'px,0)';
  })}
  ticking=false;
}
addEventListener('scroll',function(){if(!ticking){requestAnimationFrame(onScroll);ticking=true}},{passive:true});
onScroll();
totop.addEventListener('click',function(){scrollTo({top:0,behavior:RM?'auto':'smooth'})});

/* scrollspy */
var spyLinks=$$('.nlinks a');
var spy=new IntersectionObserver(function(es){
  es.forEach(function(e){
    if(e.isIntersecting){
      spyLinks.forEach(function(a){a.classList.toggle('active',a.getAttribute('data-spy')===e.target.id)});
    }
  });
},{rootMargin:'-40% 0px -55% 0px'});
['about','erg-chegaga','camp','experiences','tours','gallery','faq'].forEach(function(id){var el=document.getElementById(id);if(el)spy.observe(el)});

