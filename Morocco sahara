<script>
(function(){
  "use strict";
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.getElementById("yr").textContent = new Date().getFullYear();

  /* nav */
  var nav = document.getElementById("nav");
  function navState(){ nav.classList.toggle("scrolled", window.scrollY > 60); }
  window.addEventListener("scroll", navState, {passive:true});
  navState();

  /* mobile menu */
  var burger = document.getElementById("burger");
  var mmenu = document.getElementById("mmenu");
  function setMenu(open){
    mmenu.classList.toggle("open", open);
    burger.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", open);
    document.body.classList.toggle("lock", open);
  }
  burger.addEventListener("click", function(){ setMenu(!mmenu.classList.contains("open")); });
  mmenu.querySelectorAll("a").forEach(function(a){ a.addEventListener("click", function(){ setMenu(false); }); });

  /* hero parallax */
  var heroMedia = document.getElementById("heroMedia");
  var rafPending = false;
  function heroShift(){
    if(!reduced && window.scrollY < window.innerHeight){
      heroMedia.style.transform = "translateY(" + (window.scrollY * 0.24) + "px)";
    }
    rafPending = false;
  }
  window.addEventListener("scroll", function(){
    if(!rafPending){ rafPending = true; requestAnimationFrame(heroShift); }
  }, {passive:true});

  /* generic reveal */
  var revealObs = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ en.target.classList.add("in"); revealObs.unobserve(en.target); }
    });
  }, {threshold:.14, rootMargin:"0px 0px -6% 0px"});
  document.querySelectorAll(".rv, .dune-line, .route-track").forEach(function(el){ revealObs.observe(el); });

  /* counters */
  function runCounter(el){
    var end = parseFloat(el.getAttribute("data-count"));
    if(reduced){ el.textContent = end >= 1000 ? (end/1000).toFixed(1).replace(/\.0$/,"") + "k" : end; return; }
    var start = null, dur = 1700;
    function tick(t){
      if(!start) start = t;
      var p = Math.min((t-start)/dur, 1);
      var eased = 1 - Math.pow(1-p, 3);
      var val = Math.round(end*eased);
      el.textContent = val >= 1000 ? (val/1000).toFixed(1).replace(/\.0$/,"") + "k" : val;
      if(p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  var counterObs = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ runCounter(en.target); counterObs.unobserve(en.target); }
    });
  }, {threshold:.6});
  document.querySelectorAll("[data-count]").forEach(function(el){ counterObs.observe(el); });

  /* active nav */
  var navLinks = document.querySelectorAll("[data-nl]");
  var secObs = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){
        navLinks.forEach(function(l){ l.classList.toggle("active", l.getAttribute("data-nl") === en.target.getAttribute("data-section")); });
      }
    });
  }, {rootMargin:"-40% 0px -55% 0px"});
  document.querySelectorAll("[data-section]").forEach(function(s){ secObs.observe(s); });

  /* gallery horizontal */
  var galTrack = document.getElementById("galTrack");
  document.getElementById("galPrev").addEventListener("click", function(){ galTrack.scrollBy({left:-galTrack.clientWidth*0.7, behavior: reduced ? "auto" : "smooth"}); });
  document.getElementById("galNext").addEventListener("click", function(){ galTrack.scrollBy({left:galTrack.clientWidth*0.7, behavior: reduced ? "auto" : "smooth"}); });
  var dragging = false, dragStartX = 0, dragStartScroll = 0;
  galTrack.addEventListener("pointerdown", function(e){
    dragging = true; dragStartX = e.clientX; dragStartScroll = galTrack.scrollLeft;
    galTrack.classList.add("dragging");
  });
  window.addEventListener("pointermove", function(e){
    if(!dragging) return;
    galTrack.scrollLeft = dragStartScroll - (e.clientX - dragStartX);
  });
  window.addEventListener("pointerup", function(){
    dragging = false; galTrack.classList.remove("dragging");
  });

  /* lightbox */
  var galItems = Array.prototype.slice.call(document.querySelectorAll(".gal-card"));
  var lb = document.getElementById("lb");
  var lbImg = document.getElementById("lbImg");
  var lbCap = document.getElementById("lbCap");
  var lbCount = document.getElementById("lbCount");
  var lbIdx = 0;
  function showLb(i){
    lbIdx = (i + galItems.length) % galItems.length;
    var source = galItems[lbIdx].querySelector("img");
    lbImg.src = source.src;
    lbImg.alt = source.alt;
    lbImg.classList.toggle("kb", galItems[lbIdx].getAttribute("data-kb") === "1" && !reduced);
    lbCap.textContent = galItems[lbIdx].getAttribute("data-caption") || "";
    lbCount.textContent = (lbIdx+1) + " / " + galItems.length;
    lb.classList.add("open");
    document.body.classList.add("lock");
  }
  function hideLb(){ lb.classList.remove("open"); document.body.classList.remove("lock"); }
  galItems.forEach(function(card, i){
    card.addEventListener("click", function(){ showLb(i); });
  });
  document.getElementById("lbClose").addEventListener("click", hideLb);
  document.getElementById("lbPrev").addEventListener("click", function(e){ e.stopPropagation(); showLb(lbIdx-1); });
  document.getElementById("lbNext").addEventListener("click", function(e){ e.stopPropagation(); showLb(lbIdx+1); });
  lb.addEventListener("click", function(e){ if(e.target === lb) hideLb(); });
  document.addEventListener("keydown", function(e){
    if(!lb.classList.contains("open")) return;
    if(e.key === "Escape") hideLb();
    if(e.key === "ArrowLeft") showLb(lbIdx-1);
    if(e.key === "ArrowRight") showLb(lbIdx+1);
  });

  /* reviews crossfade */
  var rvItems = Array.prototype.slice.call(document.querySelectorAll(".rv-item"));
  var rvSlides = Array.prototype.slice.call(document.querySelectorAll(".rv-slide"));
  var rvIdx = 0, rvTimer = null;
  function rvGo(i){
    rvIdx = (i + rvSlides.length) % rvSlides.length;
    rvSlides.forEach(function(sl, k){ sl.classList.toggle("active", k === rvIdx); });
    rvItems.forEach(function(it, k){ it.classList.toggle("active", k === rvIdx); });
  }
  function rvRestart(){
    if(rvTimer) clearInterval(rvTimer);
    if(!reduced){ rvTimer = setInterval(function(){ rvGo(rvIdx+1); }, 7000); }
  }
  rvItems.forEach(function(it, k){
    it.addEventListener("click", function(){ rvGo(k); rvRestart(); });
  });
  var revSection = document.getElementById("reviews");
  revSection.addEventListener("mouseenter", function(){ if(rvTimer) clearInterval(rvTimer); });
  revSection.addEventListener("mouseleave", rvRestart);
  rvRestart();

  /* package preselect */
  var pkgSelect = document.getElementById("qPackage");
  document.querySelectorAll("[data-package]").forEach(function(trigger){
    trigger.addEventListener("click", function(){
      var wanted = trigger.getAttribute("data-package").replace(/\s+/g," ");
      for(var o=0;o<pkgSelect.options.length;o++){
        if(pkgSelect.options[o].value.replace(/\s+/g," ") === wanted){ pkgSelect.selectedIndex = o; break; }
      }
    });
  });

  /* form */
  var bookForm = document.getElementById("bookForm");
  var fSuccess = document.getElementById("fSuccess");
  bookForm.addEventListener("submit", function(e){
    e.preventDefault();
    var nm = document.getElementById("qName");
    var em = document.getElementById("qEmail");
    if(!nm.value.trim()){ nm.focus(); nm.style.borderBottomColor = "var(--terra)"; return; }
    if(!em.value.trim() || em.value.indexOf("@") < 0){ em.focus(); em.style.borderBottomColor = "var(--terra)"; return; }
    bookForm.style.display = "none";
    fSuccess.classList.add("show");
  });
  document.getElementById("fAgain").addEventListener("click", function(){
    fSuccess.classList.remove("show");
    bookForm.style.display = "";
    bookForm.reset();
  });
})();
</script>
</body>
</html>
