footer{background:var(--ink);color:var(--sand);padding:5rem 0 0;overflow:hidden}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:3rem}
.foot-brand p{font-weight:300;color:var(--txt-dark-soft);font-size:.92rem;max-width:32ch;margin-top:1.2rem}
