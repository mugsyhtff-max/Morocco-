.lb-cap{margin-top:1.4rem;font-family:var(--mono);font-size:.64rem;letter-spacing:.3em;text-transform:uppercase;color:var(--sand)}
.lb-cap i{font-style:normal;color:var(--gold-bright)}
.lb-btn{position:absolute;width:52px;height:52px;border:1px solid var(--line-dark);border-radius:50%;display:grid;place-items:center;color:var(--sand);transition:background .3s,transform .3s}
.lb-btn:hover{background:rgba(232,180,92,.18);transform:scale(1.07)}
.lb-close{top:1.5rem;right:1.8rem}
.lb-prev{left:1.8rem;top:50%;transform:translateY(-50%)}
.lb-next{right:1.8rem;top:50%;transform:translateY(-50%)}

/* ============ REVIEWS ============ */
.reviews{background:var(--night);color:var(--sand);padding:clamp(5.5rem,11vw,9rem) 0;position:relative;overflow:hidden}
.reviews::before{content:"✦";position:absolute;top:8%;right:6%;font-size:9rem;color:rgba(206,148,57,.12);animation:slowSpin 40s linear infinite}
