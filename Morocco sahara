.play-badge svg{width:14px;height:14px;margin-left:2px}
.gal-foot{text-align:center;padding-bottom:1rem;font-family:var(--mono);font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--txt-light-soft)}

/* lightbox */
