.foot-col a:hover{color:var(--gold-bright);padding-left:.45rem}
.foot-word{font-family:var(--serif);font-weight:500;font-size:clamp(3rem,11vw,8.5rem);line-height:1;white-space:nowrap;text-align:center;margin-top:4rem;color:transparent;-webkit-text-stroke:1px rgba(232,219,193,.22);user-select:none}
.foot-bar{border-top:1px solid var(--line-dark);margin-top:-1.4rem;padding:1.5rem 0;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.8rem;font-family:var(--mono);font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:rgba(232,219,193,.45)}
.foot-bar b{color:var(--gold-bright);font-weight:400}

/* ============ RESPONSIVE ============ */
@media(max-width:1020px){
  .tour-row{grid-template-columns:60px 180px 1fr;gap:1.4rem}
  .tr-aside{grid-column:2/-1;text-align:left;display:flex;align-items:center;gap:2rem}
  .rev-grid{grid-template-columns:1fr}
  .rv-stage{min-height:400px}
}
@media(max-width:900px){
  #nav ul,.nav-book{display:none}
  .burger{display:flex}
  .about-grid{grid-template-columns:1fr}
  .about-media{position:relative;top:0;order:-1;margin-bottom:3.5rem}
  .contact-grid{grid-template-columns:1fr}
  .hero-side{display:none}
  .pillars{grid-template-columns:1fr}
  .stats-strip{grid-template-columns:1fr 1fr}
  .stat:nth-child(3){border-left:none}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:700px){
  .route-track{grid-template-columns:1fr;gap:2.6rem;padding-top:0;padding-left:34px}
  .route-line,.route-fill{top:0;bottom:0;left:9px;right:auto;width:1px;height:auto}
  .route-fill{background:repeating-linear-gradient(180deg,var(--gold) 0 10px,transparent 10px 20px);transform:scaleY(0);transform-origin:top;width:2px}
  .route-track.in .route-fill{transform:scaleY(1)}
  .stop::before{top:6px;left:-30px}
  .tour-row{grid-template-columns:1fr;gap:1rem}
  .tr-img{height:200px}
  .tr-aside{grid-column:auto}
  .rv-stage{min-height:480px}
}
@media(max-width:560px){
  .f-grid{grid-template-columns:1fr}
  .stats-strip{grid-template-columns:1fr 1fr}
  .foot-grid{grid-template-columns:1fr}
  .tf-inc{font-size:.6rem}
}

/* ============ REDUCED MOTION ============ */
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
